# ──────────────────────────────────────────────
#  MyFinances — Environment Variables Template
#  Copy this file to .env.local and fill in the values.
#  Never commit .env.local to git!
# ──────────────────────────────────────────────

# Supabase (required)
# Get these from: https://supabase.com → Your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Service Role Key (server-side only — NEVER use NEXT_PUBLIC_ prefix)
# Get from: Supabase Dashboard → Settings → API → service_role key
# Used by API routes to bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App access password (required)
# This password protects the entire application.
# Set it to something strong and share it with authorised users only.
ACCESS_PASSWORD=change-me-to-something-strong

# Vercel Cron secret (required: /api/cron/snapshot returns 503 without it)
# Used to authenticate the daily portfolio snapshot cron job.
# Generate with: openssl rand -hex 32
CRON_SECRET=